# Copy to server/.env and fill in. server/.env is git-ignored.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sayc_db

# Required, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call the API directly.
# Leave empty for local development, where the Angular proxy makes calls same-origin.
# The Android app needs https://localhost, and the iOS app capacitor://localhost:
#   CORS_ORIGINS=https://localhost,capacitor://localhost
CORS_ORIGINS=
# Patterns may use * for one part of a host name, for Vercel's preview addresses:
#   CORS_ORIGINS=https://sayc.vercel.app,https://sayc-*-my-team.vercel.app

# Hosting (see DEPLOY.md). Leave unset for local development.
# Number of proxies in front of the API, so sign-in limits see each client's address. Render: 1
TRUST_PROXY=
# Create the tables on start-up when the database is empty: off, schema (tables and roles)
# or demo (also the sample companies, password admin123). A database with tables is never changed.
DB_INIT=off
# TLS to a database outside the host's private network (Aiven, TiDB Cloud...).
# DB_SSL_CA is the provider's CA certificate, in PEM; \n may stand for line breaks.
DB_SSL=false
DB_SSL_CA=
