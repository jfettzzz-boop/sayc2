# Copy to server/.env and fill in. server/.env is git-ignored.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sayc_db

# Required, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call the API directly.
# Leave empty for local development, where the Angular proxy makes calls same-origin.
CORS_ORIGINS=
